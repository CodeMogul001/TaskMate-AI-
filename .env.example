# GEMINI_API_KEY: Required for server-side Gemini AI task generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional alternative AI provider for task generation.
# Used on the server if GEMINI_API_KEY is not configured.
# OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional Supabase configuration (falls back to browser localStorage when omitted)
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
